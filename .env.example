# Copy to .env.local (web) / .env (jobs). Leave blank to run in local demo mode
# (embedded PGlite database + fixture market data + fake LLM).

# Supabase (Auth + Postgres)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Postgres connection used by Drizzle (Supabase pooler URL in production)
DATABASE_URL=

# Market data — https://www.tiingo.com (free tier)
TIINGO_TOKEN=

# SEC EDGAR requires a descriptive User-Agent: "EasyFI you@example.com"
SEC_USER_AGENT=

# BLS Public Data API v2 — https://data.bls.gov/registrationEngine/
BLS_KEY=

# LLM for the Investment Explorer — https://openrouter.ai
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Comma-separated invite codes accepted at sign-up
INVITE_CODES=

# Supabase auth user ids (comma separated) allowed to manage invites
ADMIN_USER_IDS=

# Public URL of the app (OpenRouter referer, share links), e.g. https://easyfi.vercel.app
APP_URL=

# Explorer questions per user per day (default 30)
EXPLORER_DAILY_LIMIT=

# Alert emails from the nightly job — https://resend.com (free tier)
RESEND_API_KEY=
ALERTS_FROM=EasyFI <onboarding@resend.dev>

# Local demo mode only (no Supabase): signing secret for demo sessions, PGlite data dir
DEMO_AUTH_SECRET=
EASYFI_DATA_DIR=
